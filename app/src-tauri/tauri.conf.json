{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-novel",
  "version": "0.1.0",
  "identifier": "io.github.mateuscamp.md-novel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "md-novel", "width": 1200, "height": 900, "minWidth": 720, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": { "active": false }
}
